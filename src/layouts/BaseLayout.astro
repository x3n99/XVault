---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "XVault — Developer Reference",
  description = "A curated developer cheat-sheet and code snippet library.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101110" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <dialog id="app-dialog" class="app-dialog" aria-labelledby="app-dialog-title">
      <div class="app-dialog-content">
        <div id="app-dialog-icon" class="app-dialog-icon" aria-hidden="true">
          ✓
        </div>
        <h2 id="app-dialog-title">Success</h2>
        <p id="app-dialog-message"></p>
        <div class="app-dialog-actions">
          <button type="button" id="app-dialog-cancel" hidden>Cancel</button>
          <button type="button" id="app-dialog-confirm">Continue</button>
        </div>
      </div>
    </dialog>
    <div
      id="toast-container"
      class="toast-container"
      aria-live="polite"
      aria-atomic="true"
    ></div>
    <script>
      import "../scripts/global-search";
    </script>
  </body>
</html>
