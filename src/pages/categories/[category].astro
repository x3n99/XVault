---
import { codeToHtml } from "shiki";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import SnippetCard from "../../components/SnippetCard.astro";
import { snippets } from "../../data/snippets";
import { categories, getLanguageSlug, getShikiLanguage } from "../../data/categories";

export function getStaticPaths() {
  return categories
    .filter((category) => category !== "All")
    .map((category) => ({
      params: { category: getLanguageSlug(category) },
      props: { category },
    }));
}

const { category } = Astro.props;

const categorySnippets = snippets.filter(
  (snippet) => snippet.language.toLowerCase() === category.toLowerCase(),
);

const highlightedSnippets = await Promise.all(
  categorySnippets.map(async (snippet) => ({
    ...snippet,
    html: await codeToHtml(snippet.code, {
      lang: getShikiLanguage(snippet.language),
      theme: "github-dark",
    }),
  })),
);
---

<BaseLayout
  title={`${category} Snippets — XVault`}
  description={`Browse ${category} code snippets in XVault.`}
>
  <div class="app-shell">
    <Sidebar
      categories={categories.slice(1)}
      snippetCount={snippets.length}
      currentPath={Astro.url.pathname}
    />

    <main class="category-main">
      <header class="category-topbar">
        <a href="/" class="category-back">← Back to library</a>
        <span class="category-label">XVAULT / CATEGORY</span>
      </header>

      <section class="category-heading">
        <span class="category-eyebrow">CODE COLLECTION</span>
        <h1>{category}<span>.</span></h1>
        <p>
          Browse code snippets categorized under {category}. Use these examples
          as a reference for your projects.
        </p>
        <span class="category-count">
          {categorySnippets.length}
          {categorySnippets.length === 1 ? "SNIPPET" : "SNIPPETS"}
        </span>
      </section>

      {
        highlightedSnippets.length > 0 ? (
          <div class="snippet-grid">
            {highlightedSnippets.map((snippet, index) => (
              <SnippetCard
                slug={snippet.slug}
                title={snippet.title}
                description={snippet.description}
                language={snippet.language}
                category={snippet.category}
                code={snippet.code}
                html={snippet.html}
                index={index}
              />
            ))}
          </div>
        ) : (
          <div class="category-empty">
            <h2>No snippets yet.</h2>
            <p>
              New snippets for this language can be added to the library later.
            </p>
          </div>
        )
      }
    </main>
  </div>
</BaseLayout>

<style>
  .app-shell {
    min-height: 100vh;
  }

  .category-main {
    min-height: 100vh;
    margin-left: var(--sidebar-width);
    padding: 0 42px 56px;
  }

  .category-topbar {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--border);
  }

  .category-back {
    color: var(--muted);
    font-size: 12px;
    transition: color 160ms ease;
  }

  .category-back:hover {
    color: var(--accent);
  }

  .category-label,
  .category-eyebrow,
  .category-count {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 1px;
  }

  .category-label,
  .category-eyebrow {
    color: var(--muted);
  }

  .category-heading {
    max-width: 700px;
    padding: 56px 0 36px;
  }

  .category-heading h1 {
    margin: 16px 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -2.5px;
    text-transform: capitalize;
  }

  .category-heading h1 span {
    color: var(--accent);
  }

  .category-heading p {
    max-width: 540px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .category-count {
    color: var(--accent);
  }

  .category-empty {
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }

  .category-empty h2 {
    margin: 0 0 8px;
    font-family: "Space Grotesk", sans-serif;
  }

  .category-empty p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .category-main {
      margin-left: 0;
      padding: 0 24px 40px;
    }
  }

  @media (max-width: 600px) {
    .category-main {
      padding: 0 18px 32px;
    }

    .category-topbar {
      min-height: 64px;
    }

    .category-label {
      font-size: 8px;
    }

    .category-heading {
      padding: 40px 0 28px;
    }

    .category-heading h1 {
      letter-spacing: -1.5px;
    }
  }
</style>
