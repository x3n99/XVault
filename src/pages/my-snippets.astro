---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, getLanguageSlug } from "../data/categories";
---

<BaseLayout
  title="My Snippets — XVault"
  description="Manage your personal code snippets."
>
  <main class="workspace">
    <header class="topbar">
      <a class="brand" href="/">XVault<span>.</span></a>
      <nav>
        <a href="/">Library</a>
        <a href="/favorites">Favorites</a>
        <a href="/account">My Account</a>
      </nav>
    </header>

    <section class="heading">
      <p class="eyebrow">PERSONAL WORKSPACE</p>
      <h1>My <span>snippets.</span></h1>
      <p class="description">Your private collection of reusable code.</p>
    </section>

    <p id="page-status" role="status">Checking your session...</p>

    <section class="snippet-stats" aria-label="Snippet statistics">
      <article class="stat-card">
        <span class="stat-label">Total Snippets</span>
        <strong id="stat-total">0</strong>
        <span class="stat-description">All your snippets</span>
      </article>

      <article class="stat-card">
        <span class="stat-label">Favorites</span>
        <strong id="stat-favorites">0</strong>
        <span class="stat-description">Saved favorites</span>
      </article>

      <article class="stat-card">
        <span class="stat-label">Categories</span>
        <strong id="stat-categories">0</strong>
        <span class="stat-description">Categories used</span>
      </article>

      <article class="stat-card">
        <span class="stat-label">Languages</span>
        <strong id="stat-languages">0</strong>
        <span class="stat-description">Languages used</span>
      </article>
    </section>

    <section id="snippet-workspace" hidden>
      <div class="toolbar">
        <div class="search-wrapper">
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16 16 4 4"></path>
          </svg>

          <input
            id="snippet-search"
            type="search"
            placeholder="Search snippets..."
            aria-label="Search your snippets"
          />
        </div>

        <select id="category-filter" aria-label="Filter by category">
          <option value="">All categories</option>
          <option value="General">General</option>
          <option value="Frontend">Frontend</option>
          <option value="Backend">Backend</option>
          <option value="Database">Database</option>
          <option value="DevOps">DevOps</option>
          <option value="UI/UX">UI/UX</option>
          <option value="Tools">Tools</option>
        </select>

        <select id="favorite-filter" aria-label="Filter favorites">
          <option value="all">All snippets</option>
          <option value="favorites">Favorites only</option>
        </select>

        <select id="sort-filter" aria-label="Sort snippets">
          <option value="updated-desc">Recently updated</option>
          <option value="updated-asc">Oldest updated</option>
          <option value="title-asc">Title A–Z</option>
          <option value="title-desc">Title Z–A</option>
        </select>

        <div class="toolbar-actions">
          <button type="button" id="select-mode-button">
            Select snippets
          </button>

          <button type="button" id="import-snippets-button"> Import </button>

          <input
            type="file"
            id="import-snippets-file"
            accept=".json,application/json"
            hidden
          />

          <button type="button" id="export-snippets-button">
            Export all
          </button>

          <button type="button" id="new-snippet-button" class="primary-action">
            <span aria-hidden="true">+</span>
            New snippet
          </button>
        </div>
      </div>

      <div id="selection-toolbar" class="selection-toolbar" hidden>
        <label class="select-all-label">
          <input type="checkbox" id="select-all-snippets-checkbox" />
          Select all
        </label>

        <span id="selection-count">0 selected</span>

        <button type="button" id="export-selected-snippets-button" disabled>
          Export selected
        </button>

        <button type="button" id="cancel-selection-button"> Cancel </button>
      </div>

      <div id="snippet-list" class="snippet-list"></div>

      <div id="empty-state" class="empty-state" hidden>
        <h2>No personal snippets yet.</h2>
        <p>Create your first snippet to start your collection.</p>
      </div>

      <dialog id="snippet-dialog" class="snippet-dialog">
        <form id="snippet-form">
          <div class="dialog-header">
            <div>
              <p class="eyebrow">PERSONAL WORKSPACE</p>
              <h2 id="dialog-title">New snippet</h2>
            </div>
            <button type="button" id="close-dialog" aria-label="Close editor">
              ✕
            </button>
          </div>

          <label for="snippet-title">Title</label>
          <input
            id="snippet-title"
            name="title"
            required
            maxlength="150"
            placeholder="Snippet title"
          />

          <label for="snippet-description">Description</label>
          <input
            id="snippet-description"
            name="description"
            maxlength="500"
            placeholder="What does this snippet do?"
          />

          <label for="snippet-language">Language</label>
          <select id="snippet-language" name="language">
            {
              categories.slice(1).map((language) => (
                <option value={getLanguageSlug(language)}>
                  {language}
                </option>
              ))
            }
          </select>

          <label for="snippet-category">Category</label>
          <select id="snippet-category" name="category">
            <option value="General">General</option>
            <option value="Frontend">Frontend</option>
            <option value="Backend">Backend</option>
            <option value="Database">Database</option>
            <option value="DevOps">DevOps</option>
            <option value="UI/UX">UI/UX</option>
            <option value="Tools">Tools</option>
          </select>

          <label for="snippet-tags">Tags</label>
          <input
            id="snippet-tags"
            name="tags"
            maxlength="300"
            placeholder="astro, supabase, authentication"
          />
          <p class="field-hint">Separate multiple tags with commas.</p>

          <label for="snippet-code">Code</label>
          <textarea
            id="snippet-code"
            name="code"
            required
            spellcheck="false"
            placeholder="Write or paste your code here..."></textarea>

          <div class="preview-heading">SYNTAX PREVIEW</div>
          <div id="snippet-preview" class="snippet-preview">
            <pre><code>Preview will appear here.</code></pre>
          </div>

          <p id="form-status" role="status"></p>

          <div class="dialog-actions">
            <button type="button" id="cancel-dialog">Cancel</button>
            <button type="submit" id="save-snippet-button">
              Save snippet
            </button>
          </div>
        </form>
      </dialog>
    </section>
  </main>

</BaseLayout>

<script>
  import { getAuthenticatedUser, supabase } from "../lib/supabase";
  import { codeToHtml } from "shiki";
  import { showAlert, showConfirm, showToast } from "../lib/notifications";
  import { getShikiLanguage } from "../data/categories";

  type UserSnippet = {
    id: string;
    title: string;
    description: string;
    language: string;
    code: string;
    category: string;
    tags: string[];
    is_favorite: boolean;
    created_at: string;
    updated_at: string;
  };

  const status = document.querySelector<HTMLElement>("#page-status");
  const workspace = document.querySelector<HTMLElement>("#snippet-workspace");
  const list = document.querySelector<HTMLElement>("#snippet-list");
  const emptyState = document.querySelector<HTMLElement>("#empty-state");
  const searchInput =
    document.querySelector<HTMLInputElement>("#snippet-search");

  const dialog = document.querySelector<HTMLDialogElement>("#snippet-dialog");
  const snippetForm = document.querySelector<HTMLFormElement>("#snippet-form");
  const dialogTitle = document.querySelector<HTMLElement>("#dialog-title");
  const titleInput = document.querySelector<HTMLInputElement>("#snippet-title");
  const descriptionInput = document.querySelector<HTMLInputElement>(
    "#snippet-description",
  );
  const languageInput =
    document.querySelector<HTMLSelectElement>("#snippet-language");

  const categoryInput =
    document.querySelector<HTMLSelectElement>("#snippet-category");

  const tagsInput = document.querySelector<HTMLInputElement>("#snippet-tags");

  const categoryFilter =
    document.querySelector<HTMLSelectElement>("#category-filter");

  const favoriteFilter =
    document.querySelector<HTMLSelectElement>("#favorite-filter");

  const sortFilter = document.querySelector<HTMLSelectElement>("#sort-filter");

  const codeInput =
    document.querySelector<HTMLTextAreaElement>("#snippet-code");
  const preview = document.querySelector<HTMLElement>("#snippet-preview");
  const formStatus = document.querySelector<HTMLElement>("#form-status");
  const saveButton = document.querySelector<HTMLButtonElement>(
    "#save-snippet-button",
  );

  let currentUserId: string | null = null;
  let snippets: UserSnippet[] = [];
  let editingId: string | null = null;
  let previewTimer: ReturnType<typeof setTimeout> | undefined;
  let previewRequest = 0;
  let selectionMode = false;
  const selectedSnippetIds = new Set<string>();

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };

      return entities[character];
    });
  }

  async function updatePreview() {
    if (!preview || !codeInput || !languageInput) return;

    const request = ++previewRequest;
    const code = codeInput.value;
    const language = getShikiLanguage(languageInput.value);

    try {
      const html = await codeToHtml(code || " ", {
        lang: language,
        theme: "github-dark",
      });

      if (request === previewRequest && preview) {
        preview.innerHTML = html;
      }
    } catch (error) {
      console.error("Syntax preview failed:", error);

      if (request === previewRequest && preview) {
        preview.innerHTML = `<pre><code>${escapeHtml(code)}</code></pre>`;
      }
    }
  }

  function schedulePreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => {
      void updatePreview();
    }, 250);
  }

  async function loadSnippets() {
    if (!currentUserId || !list || !emptyState) return;

    if (status) status.textContent = "Loading your snippets...";

    const { data, error } = await supabase
      .from("user_snippets")
      .select(
        "id, title, description, language, code, category, tags, is_favorite, created_at, updated_at",
      )
      .eq("user_id", currentUserId)
      .order("updated_at", { ascending: false });

    if (error) {
      console.error("Failed to load snippets:", error.message);
      if (status) status.textContent = "Failed to load snippets.";
      return;
    }

    snippets = (data ?? []) as UserSnippet[];
    renderSnippets();

    if (status) status.textContent = "";
  }

  async function highlightSnippetCards() {
    if (!list) return;

    const codeBlocks = list.querySelectorAll<HTMLElement>(
      "[data-highlight-code]",
    );

    await Promise.all(
      Array.from(codeBlocks).map(async (element) => {
        const language = element.dataset.language ?? "text";
        const code = element.textContent ?? "";
        const originalPre = element.closest("pre");

        if (!originalPre) return;

        try {
          const html = await codeToHtml(code || " ", {
            lang: getShikiLanguage(language),
            theme: "github-dark",
          });

          if (
            originalPre.isConnected &&
            element.dataset.highlightCode === "true"
          ) {
            originalPre.outerHTML = html;
          }
        } catch (error) {
          console.error("Failed to highlight snippet:", error);
        }
      }),
    );
  }

  function updateSnippetStats() {
    const total = document.querySelector("#stat-total");
    const favorites = document.querySelector("#stat-favorites");
    const categories = document.querySelector("#stat-categories");
    const languages = document.querySelector("#stat-languages");

    if (!total || !favorites || !categories || !languages) return;

    total.textContent = String(snippets.length);

    favorites.textContent = String(
      snippets.filter((snippet) => snippet.is_favorite === true).length,
    );

    categories.textContent = String(
      new Set(
        snippets.map((snippet) =>
          (snippet.category || "General").trim().toLowerCase(),
        ),
      ).size,
    );

    languages.textContent = String(
      new Set(
        snippets
          .map((snippet) => snippet.language.trim().toLowerCase())
          .filter(Boolean),
      ).size,
    );
  }

  function updateSelectionToolbar() {
    const toolbar = document.querySelector<HTMLElement>("#selection-toolbar");
    const countLabel = document.querySelector<HTMLElement>("#selection-count");
    const exportButton = document.querySelector<HTMLButtonElement>(
      "#export-selected-snippets-button",
    );
    const selectAll = document.querySelector<HTMLInputElement>(
      "#select-all-snippets-checkbox",
    );
    const selectModeButton = document.querySelector<HTMLButtonElement>(
      "#select-mode-button",
    );

    const checkboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(".snippet-select-checkbox"),
    );

    const visibleIds = checkboxes.map(
      (checkbox) => checkbox.dataset.selectSnippet,
    );

    const visibleSelectedCount = visibleIds.filter(
      (id) => id && selectedSnippetIds.has(id),
    ).length;

    const selectedCount = selectedSnippetIds.size;

    if (toolbar) toolbar.hidden = !selectionMode;

    if (countLabel) {
      countLabel.textContent = `${selectedCount} selected`;
    }

    if (exportButton) {
      exportButton.disabled = selectedCount === 0;
    }

    if (selectAll) {
      selectAll.checked =
        checkboxes.length > 0 && visibleSelectedCount === checkboxes.length;

      selectAll.indeterminate =
        visibleSelectedCount > 0 && visibleSelectedCount < checkboxes.length;
    }

    if (selectModeButton) {
      selectModeButton.textContent = selectionMode
        ? "Selecting..."
        : "Select snippets";
    }
  }

  async function importSnippets(file: File) {
    if (!currentUserId) {
      showAlert("Please log in before importing snippets.");
      return;
    }

    let parsed: unknown;

    try {
      parsed = JSON.parse(await file.text());
    } catch {
      await showAlert("Invalid JSON file.");
      return;
    }

    if (
      !parsed ||
      typeof parsed !== "object" ||
      !("snippets" in parsed) ||
      !Array.isArray(parsed.snippets)
    ) {
      showAlert("This file is not a valid XVault export.");
      return;
    }

    const validSnippets = parsed.snippets.filter((item: unknown) => {
      if (!item || typeof item !== "object") return false;

      const snippet = item as Record<string, unknown>;

      return (
        typeof snippet.title === "string" &&
        snippet.title.trim().length > 0 &&
        typeof snippet.description === "string" &&
        typeof snippet.language === "string" &&
        typeof snippet.code === "string" &&
        (snippet.category === undefined ||
          typeof snippet.category === "string") &&
        (snippet.tags === undefined ||
          (Array.isArray(snippet.tags) &&
            snippet.tags.every((tag) => typeof tag === "string"))) &&
        (snippet.is_favorite === undefined ||
          typeof snippet.is_favorite === "boolean")
      );
    });

    if (validSnippets.length === 0) {
      showAlert("No valid snippets found in this file.");
      return;
    }

    const existingKeys = new Set(
      snippets.map((snippet) =>
        JSON.stringify([
          snippet.title.trim().toLowerCase(),
          snippet.language.trim().toLowerCase(),
          snippet.code.trim(),
        ]),
      ),
    );

    const uniqueSnippets = validSnippets.filter((item: unknown) => {
      const snippet = item as Record<string, unknown>;

      const key = JSON.stringify([
        (snippet.title as string).trim().toLowerCase(),
        (snippet.language as string).trim().toLowerCase(),
        (snippet.code as string).trim(),
      ]);

      if (existingKeys.has(key)) return false;

      existingKeys.add(key);
      return true;
    });

    const skippedCount = validSnippets.length - uniqueSnippets.length;

    if (uniqueSnippets.length === 0) {
      showAlert(
        `No new snippets to import. ${skippedCount} duplicate snippet(s) skipped.`,
      );
      return;
    }

    const confirmed = await showAppDialog({
      title: "Import snippets?",
      message: `Import ${uniqueSnippets.length} new snippet(s)? ${skippedCount} duplicate snippet(s) will be skipped.`,
      variant: "confirm",
      confirmText: "Import",
      cancelText: "Cancel",
    });

    if (!confirmed) return;

    const records = uniqueSnippets.map((item: unknown) => {
      const snippet = item as Record<string, unknown>;

      return {
        user_id: currentUserId,
        title: (snippet.title as string).trim(),
        description: snippet.description as string,
        language: snippet.language as string,
        code: snippet.code as string,
        category:
          typeof snippet.category === "string" && snippet.category.trim()
            ? snippet.category.trim()
            : "General",
        tags: Array.isArray(snippet.tags)
          ? [
              ...new Set(
                (snippet.tags as string[])
                  .map((tag) => tag.trim().replace(/^#+/, "").toLowerCase())
                  .filter(Boolean),
              ),
            ]
          : [],
        is_favorite: snippet.is_favorite === true,
      };
    });

    const { error } = await supabase.from("user_snippets").insert(records);

    if (error) {
      console.error("Failed to import snippets:", error.message);
      await showAlert("Import failed. Please check the file and try again.");
      return;
    }

    await loadSnippets();
    await showAlert(
      `Successfully imported ${records.length} snippet(s). ${skippedCount} duplicate(s) skipped.`,
    );
  }

  function exportSnippets() {
    if (snippets.length === 0) {
      void showAlert("There are no snippets to export.");
      return;
    }

    const exportData = {
      app: "XVault",
      version: 1,
      exportedAt: new Date().toISOString(),
      snippets: snippets.map((snippet) => ({
        title: snippet.title,
        description: snippet.description,
        language: snippet.language,
        code: snippet.code,
        category: snippet.category || "General",
        tags: snippet.tags ?? [],
        is_favorite: snippet.is_favorite ?? false,
      })),
    };

    const json = JSON.stringify(exportData, null, 2);
    const blob = new Blob([json], {
      type: "application/json;charset=utf-8",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `xvault-snippets-${new Date()
      .toISOString()
      .slice(0, 10)}.json`;

    document.body.appendChild(link);
    link.click();
    link.remove();

    URL.revokeObjectURL(url);
  }

  function exportSelectedSnippets() {
    const selectedSnippets = snippets.filter((snippet) =>
      selectedSnippetIds.has(snippet.id),
    );

    if (selectedSnippets.length === 0) {
      void showAlert("Please select at least one snippet to export.");
      return;
    }

    const exportData = {
      app: "XVault",
      version: 1,
      exportedAt: new Date().toISOString(),
      snippets: selectedSnippets.map((snippet) => ({
        title: snippet.title,
        description: snippet.description,
        language: snippet.language,
        code: snippet.code,
        category: snippet.category || "General",
        tags: snippet.tags ?? [],
        is_favorite: snippet.is_favorite ?? false,
      })),
    };

    const blob = new Blob([JSON.stringify(exportData, null, 2)], {
      type: "application/json;charset=utf-8",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `xvault-selected-${new Date()
      .toISOString()
      .slice(0, 10)}.json`;

    document.body.appendChild(link);
    link.click();
    link.remove();

    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function toggleSelectionMode() {
    selectionMode = !selectionMode;

    if (!selectionMode) {
      selectedSnippetIds.clear();
    }

    document
      .querySelectorAll<HTMLElement>(".snippet-select")
      .forEach((label) => {
        label.hidden = !selectionMode;
      });

    document
      .querySelectorAll<HTMLInputElement>(".snippet-select-checkbox")
      .forEach((checkbox) => {
        checkbox.checked = selectedSnippetIds.has(
          checkbox.dataset.selectSnippet ?? "",
        );
      });

    updateSelectionToolbar();
  }

  function toggleSelectAllFromToolbar() {
    const selectAll = document.querySelector<HTMLInputElement>(
      "#select-all-snippets-checkbox",
    );

    if (!selectAll) return;

    document
      .querySelectorAll<HTMLInputElement>(".snippet-select-checkbox")
      .forEach((checkbox) => {
        const id = checkbox.dataset.selectSnippet;

        if (!id) return;

        if (selectAll.checked) {
          selectedSnippetIds.add(id);
        } else {
          selectedSnippetIds.delete(id);
        }

        checkbox.checked = selectedSnippetIds.has(id);
      });

    updateSelectionToolbar();
  }

  function renderSnippets() {
    if (!list || !emptyState) return;
    updateSnippetStats();

    const query = searchInput?.value.trim().toLowerCase() ?? "";
    const selectedCategory = categoryFilter?.value ?? "";
    const selectedFavorite = favoriteFilter?.value ?? "all";
    const sortOrder = sortFilter?.value ?? "updated-desc";

    const filtered = snippets.filter((snippet) => {
      const matchesCategory =
        !selectedCategory ||
        (snippet.category || "General") === selectedCategory;

      const searchableValues = [
        snippet.title,
        snippet.description,
        snippet.language,
        snippet.code,
        snippet.category || "General",
        ...(snippet.tags ?? []),
      ];

      const matchesSearch = searchableValues.some((value) =>
        (value ?? "").toLowerCase().includes(query),
      );
      const matchesFavorite =
        selectedFavorite !== "favorites" || snippet.is_favorite === true;

      return matchesCategory && matchesSearch && matchesFavorite;
    });

    filtered.sort((a, b) => {
      switch (sortOrder) {
        case "updated-asc":
          return (
            new Date(a.updated_at).getTime() - new Date(b.updated_at).getTime()
          );

        case "title-asc":
          return a.title.localeCompare(b.title, undefined, {
            sensitivity: "base",
          });

        case "title-desc":
          return b.title.localeCompare(a.title, undefined, {
            sensitivity: "base",
          });

        case "updated-desc":
        default:
          return (
            new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime()
          );
      }
    });

    list.innerHTML = filtered
      .map(
        (snippet) => `
      <article class="snippet-item">
        <label class="snippet-select" hidden>
          <input
            type="checkbox"
            class="snippet-select-checkbox"
            data-select-snippet="${snippet.id}"
            aria-label="Select ${escapeHtml(snippet.title)}"
            ${selectedSnippetIds.has(snippet.id) ? "checked" : ""}
          />
          <span>Select</span>
        </label>
        <div class="snippet-item-header">
          <div>
            <h2>${escapeHtml(snippet.title)}</h2>
            <span class="language">${escapeHtml(snippet.language)}</span>
            
            <div class="snippet-labels">
              <span class="category-badge">
                ${escapeHtml(snippet.category || "General")}
              </span>
              ${(snippet.tags ?? [])
                .map(
                  (tag) => `<span class="tag-badge">#${escapeHtml(tag)}</span>`,
                )
                .join("")}
            </div>

            <p class="snippet-updated">
              Updated ${new Date(snippet.updated_at).toLocaleDateString(
                "en-GB",
                {
                  day: "2-digit",
                  month: "short",
                  year: "numeric",
                },
              )}
            </p>
          </div>

          <div class="item-actions">
            <button
              type="button"
              class="favorite-button ${snippet.is_favorite ? "is-favorite" : ""}"
              data-action="favorite"
              data-id="${snippet.id}"
              aria-label="${snippet.is_favorite ? "Remove from favorites" : "Add to favorites"}"
              title="${snippet.is_favorite ? "Remove from favorites" : "Add to favorites"}"
            >
              ${snippet.is_favorite ? "★" : "☆"}
            </button>
            <button type="button" data-edit="${snippet.id}">Edit</button>
            <button type="button" data-delete="${snippet.id}">Delete</button>
          </div>
        </div>

        <p>${escapeHtml(snippet.description || "No description")}</p>

        <div class="snippet-code-header">
          <span>CODE</span>
          <button
            type="button"
            data-copy="${snippet.id}"
            aria-label="Copy code for ${escapeHtml(snippet.title)}"
          >
            Copy code
          </button>
        </div>

        <pre><code data-highlight-code="true" data-language="${escapeHtml(snippet.language)}">${escapeHtml(snippet.code)}</code></pre>
      </article>
    `,
      )
      .join("");

    list.querySelectorAll<HTMLElement>(".snippet-select").forEach((label) => {
      label.hidden = !selectionMode;
    });

    updateSelectionToolbar();

    emptyState.hidden = filtered.length > 0;
    list.hidden = filtered.length === 0;
    void highlightSnippetCards();

    const emptyTitle = emptyState.querySelector("h2");
    const emptyDescription = emptyState.querySelector("p");

    if (emptyTitle && emptyDescription) {
      if (snippets.length === 0) {
        emptyTitle.textContent = "No personal snippets yet.";
        emptyDescription.textContent =
          "Create your first snippet to start your collection.";
      } else {
        emptyTitle.textContent = "No matching snippets.";
        emptyDescription.textContent = "Try a different search term.";
      }
    }
  }

  async function toggleFavorite(id: string) {
    if (!currentUserId) return;

    const snippet = snippets.find((item) => item.id === id);
    if (!snippet) return;

    const nextFavorite = !snippet.is_favorite;

    const { error } = await supabase
      .from("user_snippets")
      .update({ is_favorite: nextFavorite })
      .eq("id", id)
      .eq("user_id", currentUserId);

    if (error) {
      console.error("Failed to update favorite:", error);
      await showAlert("Failed to update favorite. Please try again.");
      return;
    }

    snippet.is_favorite = nextFavorite;
    renderSnippets();
  }

  function openEditor(snippet?: UserSnippet) {
    if (
      !dialog ||
      !snippetForm ||
      !titleInput ||
      !descriptionInput ||
      !languageInput ||
      !categoryInput ||
      !tagsInput ||
      !codeInput ||
      !dialogTitle ||
      !formStatus ||
      !saveButton ||
      !preview
    ) {
      return;
    }

    snippetForm.reset();
    editingId = snippet?.id ?? null;

    dialogTitle.textContent = snippet ? "Edit snippet" : "New snippet";
    saveButton.textContent = snippet ? "Save changes" : "Save snippet";

    titleInput.value = snippet?.title ?? "";
    descriptionInput.value = snippet?.description ?? "";
    languageInput.value = snippet?.language ?? "javascript";
    categoryInput.value = snippet?.category ?? "General";
    tagsInput.value = (snippet?.tags ?? []).join(", ");
    codeInput.value = snippet?.code ?? "";

    formStatus.textContent = "";
    preview.innerHTML = "<pre><code>Preparing preview...</code></pre>";

    dialog.showModal();
    void updatePreview();

    titleInput.focus();
  }

  function closeEditor() {
    if (!dialog || !snippetForm || !formStatus) return;

    clearTimeout(previewTimer);
    previewRequest++;

    dialog.close();
    snippetForm.reset();
    editingId = null;
    formStatus.textContent = "";
  }

  async function initialize() {
    try {
      const { data, error } = await getAuthenticatedUser();

      if (error || !data.user) {
        window.location.replace("/login");
        return;
      }

      currentUserId = data.user.id;

      if (workspace) workspace.hidden = false;

      await loadSnippets();
    } catch (error) {
      console.error("Failed to initialize the snippet workspace:", error);
      if (status) {
        const reason =
          error instanceof Error ? ` (${error.message})` : "";
        status.textContent =
          `Could not verify your session${reason}. Check your connection and refresh the page.`;
      }
    }
  }

  void initialize();

  searchInput?.addEventListener("input", renderSnippets);

  categoryFilter?.addEventListener("change", renderSnippets);
  favoriteFilter?.addEventListener("change", renderSnippets);
  sortFilter?.addEventListener("change", renderSnippets);

  document
    .querySelector<HTMLButtonElement>("#new-snippet-button")
    ?.addEventListener("click", () => openEditor());

  const importButton = document.querySelector<HTMLButtonElement>(
    "#import-snippets-button",
  );

  const importFileInput = document.querySelector<HTMLInputElement>(
    "#import-snippets-file",
  );

  importButton?.addEventListener("click", () => {
    importFileInput?.click();
  });

  importFileInput?.addEventListener("change", async () => {
    const file = importFileInput.files?.[0];
    if (!file) return;

    try {
      await importSnippets(file);
    } finally {
      importFileInput.value = "";
    }
  });

  document
    .querySelector<HTMLButtonElement>("#export-snippets-button")
    ?.addEventListener("click", exportSnippets);

  document
    .querySelector<HTMLButtonElement>("#export-selected-snippets-button")
    ?.addEventListener("click", exportSelectedSnippets);

  document
    .querySelector<HTMLButtonElement>("#select-mode-button")
    ?.addEventListener("click", toggleSelectionMode);

  document
    .querySelector<HTMLInputElement>("#select-all-snippets-checkbox")
    ?.addEventListener("change", toggleSelectAllFromToolbar);

  document
    .querySelector<HTMLButtonElement>("#cancel-selection-button")
    ?.addEventListener("click", () => {
      selectionMode = false;
      selectedSnippetIds.clear();

      document
        .querySelectorAll<HTMLElement>(".snippet-select")
        .forEach((label) => {
          label.hidden = true;
        });

      document
        .querySelectorAll<HTMLInputElement>(".snippet-select-checkbox")
        .forEach((checkbox) => {
          checkbox.checked = false;
        });

      updateSelectionToolbar();
    });

  list?.addEventListener("change", (event) => {
    const target = event.target;

    if (
      !(target instanceof HTMLInputElement) ||
      !target.matches(".snippet-select-checkbox")
    ) {
      return;
    }

    const id = target.dataset.selectSnippet;

    if (!id) return;

    if (target.checked) {
      selectedSnippetIds.add(id);
    } else {
      selectedSnippetIds.delete(id);
    }

    updateSelectionToolbar();
  });

  document
    .querySelector<HTMLButtonElement>("#close-dialog")
    ?.addEventListener("click", closeEditor);

  document
    .querySelector<HTMLButtonElement>("#cancel-dialog")
    ?.addEventListener("click", closeEditor);

  codeInput?.addEventListener("input", schedulePreview);
  languageInput?.addEventListener("change", schedulePreview);

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeEditor();
  });

  list?.addEventListener("click", async (event) => {
    const target = event.target;

    if (!(target instanceof HTMLButtonElement)) return;
    const copyId = target.dataset.copy;

    if (copyId) {
      const snippet = snippets.find((item) => item.id === copyId);
      if (!snippet) return;

      try {
        await navigator.clipboard.writeText(snippet.code);

        const originalText = target.textContent;
        target.textContent = "Copied!";
        target.disabled = true;
        showToast("Code copied to clipboard.");

        window.setTimeout(() => {
          if (target.isConnected) {
            target.textContent = originalText;
            target.disabled = false;
          }
        }, 1500);
      } catch (error) {
        console.error("Failed to copy snippet:", error);
        await showAlert("Could not copy the code. Please copy it manually.");
      }

      return;
    }

    const favoriteId = target.dataset.id;
    const action = target.dataset.action;

    if (action === "favorite" && favoriteId) {
      await toggleFavorite(favoriteId);
      return;
    }

    const editId = target.dataset.edit;
    const deleteId = target.dataset.delete;

    if (editId) {
      const snippet = snippets.find((item) => item.id === editId);

      if (snippet) openEditor(snippet);
      return;
    }

    if (deleteId) {
      const snippet = snippets.find((item) => item.id === deleteId);

      if (!snippet || !currentUserId) return;

      const confirmed = await showConfirm(
        `Delete "${snippet.title}"? This action cannot be undone.`,
      );

      if (!confirmed) return;

      target.disabled = true;

      const { error } = await supabase
        .from("user_snippets")
        .delete()
        .eq("id", deleteId)
        .eq("user_id", currentUserId);

      if (error) {
        console.error("Failed to delete snippet:", error.message);
        await showAlert("Failed to delete snippet. Please try again.");
        target.disabled = false;
        return;
      }

      snippets = snippets.filter((item) => item.id !== deleteId);
      selectedSnippetIds.delete(deleteId);
      renderSnippets();
    }
  });

  snippetForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (
      !currentUserId ||
      !titleInput ||
      !descriptionInput ||
      !languageInput ||
      !categoryInput ||
      !tagsInput ||
      !codeInput ||
      !formStatus ||
      !saveButton
    ) {
      return;
    }

    const wasEditing = Boolean(editingId);
    const snippetId = editingId;

    const payload = {
      title: titleInput.value.trim(),
      description: descriptionInput.value.trim(),
      language: languageInput.value,
      category: categoryInput.value,
      tags: [
        ...new Set(
          tagsInput.value
            .split(",")
            .map((tag) => tag.trim().replace(/^#+/, "").toLowerCase())
            .filter(Boolean),
        ),
      ],
      code: codeInput.value,
      updated_at: new Date().toISOString(),
    };

    if (!payload.title || !payload.code.trim()) {
      formStatus.textContent = "Title and code are required.";
      return;
    }

    saveButton.disabled = true;
    formStatus.textContent = "Saving snippet...";

    try {
      if (snippetId) {
        const { error } = await supabase
          .from("user_snippets")
          .update(payload)
          .eq("id", snippetId)
          .eq("user_id", currentUserId);

        if (error) throw error;
      } else {
        const { error } = await supabase.from("user_snippets").insert({
          ...payload,
          user_id: currentUserId,
        });

        if (error) throw error;
      }

      closeEditor();
      await loadSnippets();
      await showAlert(
        wasEditing
          ? "Your snippet has been updated successfully."
          : "Your snippet has been created successfully.",
        "success",
        wasEditing ? "Changes saved" : "Snippet created",
      );
    } catch (error) {
      console.error("Failed to save snippet:", error);
      formStatus.textContent = "Failed to save. Please try again.";
    } finally {
      saveButton.disabled = false;
      saveButton.textContent = wasEditing ? "Save changes" : "Save snippet";
    }
  });

</script>

<script is:inline>
  let startupError = "";

  window.addEventListener("error", (event) => {
    if (event.message) startupError = event.message;
  });

  window.addEventListener("unhandledrejection", (event) => {
    startupError =
      event.reason instanceof Error
        ? event.reason.message
        : String(event.reason);
  });

  window.setTimeout(() => {
    const status = document.querySelector("#page-status");
    if (status?.textContent?.trim() === "Checking your session...") {
      status.textContent = startupError
        ? `Workspace startup failed: ${startupError}`
        : "Workspace startup did not run. Check the browser console and reload the page.";
    }
  }, 20_000);
</script>

