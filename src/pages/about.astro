---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { snippets } from "../data/snippets";
import { categories } from "../data/categories";
---

<BaseLayout
  title="About — XVault"
  description="Learn about XVault, a personal developer reference and code snippet library."
>
  <div class="app-shell">
    <Sidebar
      categories={categories.slice(1)}
      snippetCount={snippets.length}
      currentPath={Astro.url.pathname}
    />

    <main class="about-page">
      <header class="about-topbar">
        <a class="about-back" href="/">← Back to library</a>
        <span class="about-label">XVAULT / ABOUT</span>
      </header>

    <section class="about-hero">
      <span class="about-eyebrow">ABOUT THE PROJECT / 001</span>

      <h1>
        A quieter place<br />
        to <span>think in code.</span>
      </h1>

      <p class="about-intro">
        XVault is a personal developer reference built to keep useful code
        snippets, patterns, and technical notes organized in one place. No
        clutter. Just practical references for the work ahead.
      </p>
    </section>

    <section class="about-details">
      <article class="about-card">
        <span class="about-number">01 / PURPOSE</span>
        <h2>Built for reference.</h2>
        <p>
          A focused library for revisiting useful solutions without searching
          through scattered files, old projects, or browser tabs.
        </p>
      </article>

      <article class="about-card">
        <span class="about-number">02 / APPROACH</span>
        <h2>Simple by design.</h2>
        <p>
          Clear categories, readable syntax highlighting, and copyable code keep
          the focus on the information itself.
        </p>
      </article>

      <article class="about-card">
        <span class="about-number">03 / STACK</span>
        <h2>Made with modern tools.</h2>
        <p>
          Astro generates the pages, while Shiki handles syntax highlighting.
          The result is a lightweight static site with no database required.
        </p>
      </article>
    </section>

    <section class="about-cta">
      <div>
        <span class="about-eyebrow">THE LIBRARY</span>
        <h2>Back to building.</h2>
      </div>

      <a href="/">Explore snippets <span>↗</span></a>
    </section>

    <footer class="about-footer">
      <span>© {new Date().getFullYear()} XVault</span>
      <span>BUILT FOR THE CRAFT OF CODE ✳</span>
    </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .about-page {
    min-height: 100vh;
    margin-left: var(--sidebar-width);
    padding: 0 42px 56px;
  }

  .about-topbar {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--border);
  }

  .about-hero h1 span {
    color: var(--accent);
  }

  .about-label,
  .about-eyebrow,
  .about-number {
    color: var(--muted);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 1.2px;
  }

  .about-back {
    color: var(--muted);
    font-size: 12px;
    transition: color 160ms ease;
  }

  .about-back:hover {
    color: var(--accent);
  }

  .about-hero {
    max-width: 850px;
    padding: 56px 0 36px;
  }

  .about-hero h1 {
    margin: 16px 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -2.5px;
  }

  .about-intro {
    max-width: 590px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.9;
  }

  .about-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .about-card {
    min-height: 220px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .about-card h2 {
    margin: 28px 0 12px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 20px;
    letter-spacing: -0.5px;
  }

  .about-card p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
  }

  .about-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 70px;
    padding: 34px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .about-cta h2 {
    margin: 10px 0 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 28px;
    letter-spacing: -1px;
  }

  .about-cta > a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 13px 17px;
    border-radius: 5px;
    background: var(--accent);
    color: #101110;
    font-size: 12px;
    font-weight: 600;
    transition: transform 160ms ease;
  }

  .about-cta > a:hover {
    transform: translateY(-2px);
  }

  .about-cta > a span {
    font-size: 16px;
  }

  .about-footer {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.5px;
  }

  @media (max-width: 850px) {
    .about-details {
      grid-template-columns: 1fr;
    }

    .about-card {
      min-height: auto;
    }

    .about-card h2 {
      margin-top: 20px;
    }
  }

  @media (max-width: 600px) {
    .about-page {
      margin-left: 0;
      padding: 0 18px 32px;
    }

    .about-topbar {
      min-height: 64px;
    }

    .about-label {
      font-size: 8px;
    }

    .about-hero {
      padding: 40px 0 28px;
    }

    .about-hero h1 {
      letter-spacing: -1.5px;
    }

    .about-cta {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 48px;
    }

    .about-footer {
      align-items: flex-start;
      justify-content: center;
      flex-direction: column;
      padding: 18px 0;
    }
  }
</style>
