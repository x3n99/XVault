---
import { codeToHtml } from "shiki";
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import SnippetCard from "../components/SnippetCard.astro";
import { snippets } from "../data/snippets";
import { getShikiLanguage } from "../data/categories";
import { categories } from "../data/categories";

const highlightedSnippets = await Promise.all(
  snippets.map(async (snippet) => ({
    ...snippet,
    html: await codeToHtml(snippet.code, {
      lang: getShikiLanguage(snippet.language),
      theme: "github-dark",
    }),
  })),
);
---

<BaseLayout
  title="Favorites — XVault"
  description="Your bookmarked code snippets in XVault."
>
  <div class="app-shell">
    <Sidebar
      categories={categories.slice(1)}
      snippetCount={snippets.length}
      currentPath={Astro.url.pathname}
    />

    <main class="favorites-main">
      <header class="favorites-topbar">
        <a href="/" class="favorites-back">← Back to library</a>
        <span class="favorites-label">XVAULT / SAVED REFERENCES</span>
      </header>

      <section class="favorites-heading">
        <span class="favorites-eyebrow">YOUR COLLECTION / 001</span>
        <h1>Saved <span>snippets.</span></h1>
        <p>Your bookmarked references, kept together for quick access.</p>
        <div class="favorites-search">
          <span aria-hidden="true">⌕</span>
          <input
            id="favorites-search"
            type="search"
            placeholder="Search your saved snippets..."
            aria-label="Search saved snippets"
          />
          <kbd>SEARCH</kbd>
        </div>
      </section>

      <div class="favorites-grid snippet-grid">
        {
          highlightedSnippets.map((snippet, index) => (
            <article
              class="snippet-card favorite-card"
              data-favorite={snippet.slug}
              data-language={snippet.language}
            >
              <div class="card-header">
                <div class="card-title-group">
                  <span class="card-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>
                    <a
                      class="snippet-title-link"
                      href={`/snippets/${snippet.slug}`}
                    >
                      {snippet.title}
                    </a>
                  </h3>
                </div>

                <button
                  class="bookmark-button"
                  type="button"
                  data-bookmark={snippet.slug}
                  aria-label={`Remove bookmark from ${snippet.title}`}
                  aria-pressed="true"
                  title="Remove bookmark"
                >
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M6 4.75A1.75 1.75 0 0 1 7.75 3h8.5A1.75 1.75 0 0 1 18 4.75V21l-6-4-6 4V4.75Z"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </div>

              <p class="card-description">{snippet.description}</p>

              <div class="code-container">
                <div class="code-toolbar">
                  <span class="code-indicator" />
                  <span>{snippet.language.toLowerCase()}</span>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy={snippet.code}
                    aria-label={`Copy ${snippet.title}`}
                  >
                    <span>Copy</span>
                  </button>
                </div>
                <div class="code-content" set:html={snippet.html} />
              </div>

              <div class="card-footer">
                <span>{snippet.category}</span>
                <a class="card-arrow" href={`/snippets/${snippet.slug}`}>
                  View details ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="favorites-empty" hidden>
        <span class="empty-symbol">✳</span>
        <h2>No saved snippets yet.</h2>
        <p>
          Bookmark useful snippets from the library and they will appear here.
        </p>
        <a href="/">Explore library ↗</a>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { showAlert } from "../lib/notifications";

  const grid = document.querySelector<HTMLElement>(".favorites-grid");
  const emptyState = document.querySelector<HTMLElement>(".favorites-empty");
  const searchInput =
    document.querySelector<HTMLInputElement>("#favorites-search");

  let bookmarks: string[] = [];

  function renderFavorites() {
    if (!grid || !emptyState) return;

    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visibleCount = 0;

    grid.querySelectorAll<HTMLElement>("[data-favorite]").forEach((card) => {
      const slug = card.dataset.favorite ?? "";
      const isSaved = bookmarks.includes(slug);

      card
        .querySelectorAll<HTMLButtonElement>("[data-bookmark]")
        .forEach((button) => {
          button.setAttribute("aria-pressed", String(isSaved));
          button.setAttribute(
            "aria-label",
            `${isSaved ? "Remove bookmark from" : "Bookmark"} ${slug}`,
          );
          button.title = isSaved ? "Remove bookmark" : "Bookmark snippet";
        });

      const searchableText = card.textContent?.toLowerCase() ?? "";
      const codeText =
        card
          .querySelector<HTMLElement>(".code-content")
          ?.textContent?.toLowerCase() ?? "";

      const matchesSearch =
        !query || searchableText.includes(query) || codeText.includes(query);

      card.hidden = !isSaved || !matchesSearch;

      if (isSaved && matchesSearch) visibleCount++;
    });

    emptyState.hidden = visibleCount > 0;
    grid.hidden = visibleCount === 0;
  }

  async function loadFavorites() {
    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser();

    if (authError || !user) {
      window.location.replace("/login");
      return;
    }

    const { data, error } = await supabase
      .from("user_bookmarks")
      .select("snippet_slug");

    if (error) {
      console.error("Failed to load favorites:", error.message);
      await showAlert(
        "Gagal memuat Favorites. Silakan refresh halaman.",
        "error",
      );
      return;
    }

    bookmarks = data.map((item) => item.snippet_slug);
    renderFavorites();
  }

  grid
    ?.querySelectorAll<HTMLButtonElement>("[data-bookmark]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const slug = button.dataset.bookmark;
        if (!slug || button.disabled) return;

        button.disabled = true;

        try {
          const {
            data: { user },
            error: authError,
          } = await supabase.auth.getUser();

          if (authError || !user) {
            window.location.href = "/login";
            return;
          }

          const { error } = await supabase
            .from("user_bookmarks")
            .delete()
            .eq("user_id", user.id)
            .eq("snippet_slug", slug);

          if (error) throw error;

          bookmarks = bookmarks.filter((item) => item !== slug);
          renderFavorites();

          window.dispatchEvent(new Event("xvault-bookmarks-updated"));
        } catch (error) {
          console.error("Failed to remove bookmark:", error);
          await showAlert("Gagal menghapus bookmark. Silakan coba lagi.", "error");
        } finally {
          button.disabled = false;
        }
      });
    });

  grid?.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = button.dataset.copy;
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
        const label = button.querySelector("span");
        if (!label) return;

        label.textContent = "Copied!";
        window.setTimeout(() => {
          label.textContent = "Copy";
        }, 1500);
      } catch {
        const label = button.querySelector("span");
        if (label) label.textContent = "Failed";
      }
    });
  });

  searchInput?.addEventListener("input", renderFavorites);

  void loadFavorites();
</script>

<style>
  .favorites-main {
    min-height: 100vh;
    margin-left: var(--sidebar-width);
    padding: 0 42px 56px;
  }

  .favorites-topbar {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--border);
  }

  .favorites-back {
    color: var(--muted);
    font-size: 12px;
  }

  .favorites-back:hover {
    color: var(--accent);
  }

  .favorites-label,
  .favorites-eyebrow {
    color: var(--muted);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 1.2px;
  }

  .favorites-heading {
    padding: 56px 0 36px;
  }

  .favorites-heading h1 {
    margin: 16px 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -2.5px;
  }

  .favorites-heading h1 span {
    color: var(--accent);
  }

  .favorites-heading p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .favorites-empty {
    padding: 44px 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    text-align: center;
  }

  .empty-symbol {
    color: var(--accent);
    font-size: 26px;
  }

  .favorites-empty h2 {
    margin: 18px 0 10px;
    font-family: "Space Grotesk", sans-serif;
  }

  .favorites-empty p {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }

  .favorites-empty a {
    color: var(--accent);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .favorites-main {
      margin-left: 0;
      padding: 0 24px 40px;
    }
  }

  @media (max-width: 600px) {
    .favorites-main {
      padding: 0 18px 32px;
    }

    .favorites-topbar {
      min-height: 64px;
    }

    .favorites-label {
      font-size: 8px;
    }

    .favorites-heading {
      padding: 40px 0 28px;
    }

    .favorites-heading h1 {
      letter-spacing: -1.5px;
    }
  }
  .favorites-search {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    padding: 0 16px;
    min-height: 48px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--surface);
  }

  .favorites-search > span {
    color: var(--muted);
    font-size: 22px;
  }

  .favorites-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 12px;
  }

  .favorites-search input::placeholder {
    color: var(--muted);
  }

  .favorites-search kbd {
    flex-shrink: 0;
    color: var(--muted);
    font-family: "DM Mono", monospace;
    font-size: 9px;
    letter-spacing: 1px;
  }
</style>
